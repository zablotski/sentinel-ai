# LangSmith / LangChain tracing (https://smith.langchain.com/settings)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_copied_ls_api_key_here
LANGCHAIN_PROJECT=sentinel-ai-backend

# Modern LangSmith aliases (optional — synced from LANGCHAIN_* on boot)
LANGSMITH_API_KEY=your_copied_ls_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=sentinel-ai-backend

# Local stack (optional overrides)
OLLAMA_BASE_URL=http://localhost:11434/v1
QDRANT_HOST=http://localhost:6333

# Provider/model selection: sentinel.models.yml is the default; LLM_PROVIDER here
# (if set) overrides the `provider:` key in that file.
# SENTINEL_MODELS_PATH=/path/to/custom.models.yml
# LLM_PROVIDER=ollama


GROQ_API_KEY=YOUR_API_KEY_HERE
LLM_PROVIDER=groq